# CivicAI Server — Environment Template
# Copy to `.env` and fill in real values. Never commit `.env`.

# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas free tier recommended)
MONGODB_URI=mongodb://localhost:27017/civicai

# REQUIRED — used to sign JWTs. Pick a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change_me_to_a_long_random_string

# REQUIRED for GOV (authority) self-registration — a shared secret.
# GOV accounts are NOT open to the public; registration requires this key.
# For the demo, run `node scripts/seedAdmin.js` to create the seeded GOV account.
GOV_ACCESS_KEY=change_me_demo_gov_key

# Cloudinary (image uploads) — https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Groq (AI vision + workforce reasoning) — https://console.groq.com
# Optional: without it the app falls back to filename-based mock analysis.
GROQ_API_KEY=your_groq_api_key

# Optional: default city for seeding scripts (used by seedWorkTeams.js)
DEFAULT_CITY=Chennai
